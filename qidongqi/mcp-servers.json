{
  "mcpServers": {
    "ddg-search": {
      "command": "uvx",
      "args": ["--with", "duckduckgo-mcp-server[browser]", "duckduckgo-mcp-server"],
      "env": {
        "DDG_SAFE_SEARCH": "MODERATE",
        "DDG_REGION": "cn-zh"
      }
    },
    "anytxt": {
      "command": "${PYTHON}",
      "args": ["${BASE_DIR}/qidongqi/anytxt_mcp_bridge.py"]
    }
  }
}
