{
  "version": "1.0",
  "comment": "MCP 服务配置 - 复制为 mcp_servers.local.json 修改。支持 ${PYTHON} ${BASE_DIR} ${MODELS_DIR} 占位符。",
  "servers": [
    {
      "name": "anytxt",
      "enabled": true,
      "command": "${PYTHON}",
      "args": ["${BASE_DIR}/qidongqi/anytxt_mcp_bridge.py"],
      "env": {},
      "timeout": 30,
      "description": "AnyTxt 本地全文检索"
    },
    {
      "name": "web-search-sogou",
      "enabled": false,
      "command": "uvx",
      "args": ["--with", "sogou-mcp-server", "sogou-mcp-server"],
      "env": {"REGION": "cn", "SAFE_SEARCH": "MODERATE"},
      "timeout": 30,
      "description": "搜狗联网搜索（需安装 sogou-mcp-server）"
    },
    {
      "name": "web-search-bing",
      "enabled": false,
      "command": "uvx",
      "args": ["--with", "bing-mcp-server", "bing-mcp-server"],
      "env": {"MARKET": "zh-CN"},
      "timeout": 30,
      "description": "必应联网搜索（需安装 bing-mcp-server）"
    },
    {
      "name": "sqlite",
      "enabled": false,
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "${BASE_DIR}/data/knowledge.db"],
      "env": {},
      "timeout": 10,
      "description": "SQLite 数据库查询"
    }
  ]
}